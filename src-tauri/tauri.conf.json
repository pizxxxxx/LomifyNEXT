{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LomifyNEXT",
  "version": "9.5.1",
  "identifier": "com.lomify.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "LomifyNEXT",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#111014"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http://asset.localhost https: http: ws: wss:; media-src 'self' asset: http://asset.localhost https: http: blob:; img-src 'self' asset: http://asset.localhost https: http: data: blob:; connect-src 'self' asset: http://asset.localhost https: http: ws: wss:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "lomify",
    "copyright": "Copyright © 2026 pizx",
    "licenseFile": "installer/license.rtf",
    "resources": [
      "resources/zapret/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
